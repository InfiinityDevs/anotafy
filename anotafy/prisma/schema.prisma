// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
     provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum StatusEmpresa {
    ATIVA      @map("ATIVA")
    INATIVA    @map("INATIVA")
    SUSPENSA   @map("SUSPENSA")
}

enum TipoUnidade {
    MATRIZ     @map("MATRIZ")
    FILIAL     @map("FILIAL")
    ESCRITORIO @map("ESCRITORIO")
    DEPOSITO   @map("DEPOSITO")
}

enum StatusUnidade {
    ATIVA      @map("ATIVA")
    INATIVA    @map("INATIVA")
    EM_REFORMA @map("EM_REFORMA")
}

enum YesNo {
    YES        @map("YES")
    NO         @map("NO")
}

enum StatusItem {
    NA_COZINHA @map("NA_COZINHA")
    PREPARANDO @map("PREPARANDO")
    PRONTO     @map("PRONTO")
    ENTREGUE   @map("ENTREGUE")
}

enum StatusComanda {
    OCUPADA       @map("OCUPADA")
    EM_FECHAMENTO @map("EM_FECHAMENTO")
    FINALIZADA    @map("FINALIZADA")
}

enum StatusMesa {
    LIVRE              @map("LIVRE")
    OCUPADA            @map("OCUPADA")
    EM_FECHAMENTO      @map("EM_FECHAMENTO")
    AGUARDANDO_LIMPEZA @map("AGUARDANDO_LIMPEZA")
    BLOQUEADA          @map("BLOQUEADA")
    RESERVADA          @map("RESERVADA")
}

model Empresa {
    id              Int       @id @default(autoincrement())
    razao_social    String    @db.VarChar(200)
    nome_fantasia   String?    @db.VarChar(200)
    cnpj_raiz       String?    @db.VarChar(8) @unique
    data_fundacao   String?    @db.VarChar(8)
    cnae_principal  String?    @db.VarChar(10)
    telefone_principal String @db.VarChar(20) @unique
    email_principal String    @db.VarChar(150) @unique
    website         String?   @db.VarChar(100)
    logo_url        String?   @db.VarChar(500)
    status          StatusEmpresa @default(ATIVA)
    data_cadastro   DateTime  @default(now())
    data_atualizacao DateTime @updatedAt

    // Relacionamentos
    unidades Unidade[]
}

model Unidade {
    id                      Int           @id @default(autoincrement())
    matriz_id               Int?
    matriz                  Unidade?      @relation("UnidadeMatriz", fields: [matriz_id], references: [id], onDelete: Cascade)
    filiais                 Unidade[]     @relation("UnidadeMatriz")
    nome                    String        @db.VarChar(150)
    tipo_unidade            TipoUnidade
    cnpj                    String?        @db.VarChar(14) @unique
    cep                     String?        @db.VarChar(8)
    logradouro              String?        @db.VarChar(200)
    numero                  String?        @db.VarChar(10)
    complemento             String?       @db.VarChar(100)
    bairro                  String?        @db.VarChar(100)
    cidade                  String?        @db.VarChar(100)
    estado                  String?        @db.Char(2)
    codigo_ibge_municipio   String?        @db.VarChar(7)
    telefone                String        @db.VarChar(15) @unique
    email                   String        @db.VarChar(150) @unique
    status                  StatusUnidade @default(ATIVA)
    data_abertura           String?        @db.VarChar(8)
    data_cadastro           DateTime      @default(now())
    data_atualizacao        DateTime      @updatedAt
  
    // Relacionamentos
    empresa_id              Int
    empresa                 Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
    categorias              Categoria[]
    usuarios                Usuario[]
    mesas                   Mesa[]

}

model Categoria {
    id          Int      @id @default(autoincrement())
    nome        String   @db.VarChar(100)
    descricao   String?  @db.VarChar(500)

    data_cadastro    DateTime @default(now())
    data_atualizacao DateTime @updatedAt

    pai_id      Int?
    pai         Categoria?   @relation("CategoriaHierarquia", fields: [pai_id], references: [id], onDelete: Cascade)
    filhos      Categoria[]  @relation("CategoriaHierarquia")

    // Relacionamentos
    unidade_id  Int
    unidade     Unidade @relation(fields: [unidade_id], references: [id], onDelete: Cascade)
    produtos    Produto[]
}

model Produto {
    id          Int      @id @default(autoincrement())
    nome        String   @db.VarChar(200)
    descricao   String?  @db.VarChar(1000)
    preco       Decimal  @db.Decimal(10, 2)
    status      YesNo @default(YES)
    
    // Timestamps automáticos
    data_cadastro    DateTime @default(now())
    data_atualizacao DateTime @updatedAt

    // Relacionamentos
    categoria_id    Int
    categoria       Categoria @relation(fields: [categoria_id], references: [id], onDelete: Cascade)
    itens_comanda   ItemComanda[]
}

model Usuario {
    id                    Int          @id @default(autoincrement())
    nome                  String       @db.VarChar(150)
    status                YesNo        @default(YES)
    codigo_identificacao  String       @db.VarChar(50)
    login                 String       @db.VarChar(100) @unique
    senha                 String       @db.VarChar(255)
    data_cadastro         DateTime     @default(now())
    data_atualizacao      DateTime     @updatedAt

    // Relacionamentos
    unidade_id Int
    unidade               Unidade      @relation(fields: [unidade_id], references: [id], onDelete: Cascade)
    itens_comanda ItemComanda[]
}

model Mesa {
    id               Int          @id @default(autoincrement())
    identificacao    String       @db.VarChar(50)
    capacidade       Int?
    status           StatusMesa   @default(LIVRE)
    data_cadastro    DateTime     @default(now())
    data_atualizacao DateTime     @updatedAt

    // Relacionamentos
    unidade_id       Int
    unidade         Unidade       @relation(fields: [unidade_id], references: [id], onDelete: Cascade)
    comandas        Comanda[]
}

model Comanda {
    id               Int            @id @default(autoincrement())
    pessoas          Int?            @default(1)
    hora_abertura    DateTime       @default(now())
    hora_fechamento  DateTime?
    status           StatusComanda  @default(OCUPADA)
    data_cadastro    DateTime       @default(now())
    data_atualizacao DateTime       @updatedAt
    
    // Relacionamentos
    mesa_id          Int
    mesa             Mesa           @relation(fields: [mesa_id], references: [id], onDelete: Cascade)
    itens_comanda    ItemComanda[]
}

model ItemComanda {
    id               Int          @id @default(autoincrement())
    comanda_id       Int
    usuario_id       Int?
    produto_id       Int
    preco_unitario   Decimal       @db.Decimal(10, 2)
    quantidade       Int           @default(1)
    observacao       String?       @db.VarChar(500)
    status_item      StatusItem    @default(NA_COZINHA)
    hora_adicionado  DateTime      @default(now())
    hora_atualizado  DateTime      @updatedAt

    // Relacionamentos

    comanda          Comanda       @relation(fields: [comanda_id], references: [id], onDelete: Cascade)
    usuario          Usuario?       @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
    produto          Produto       @relation(fields: [produto_id], references: [id], onDelete: Cascade)

}


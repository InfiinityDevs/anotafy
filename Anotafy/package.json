{
  "name": "anotafy-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "yarn --cwd server dev",
    "dev:client": "yarn --cwd client dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"green,blue\" \"yarn dev:server\" \"yarn dev:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.27"
  }
}

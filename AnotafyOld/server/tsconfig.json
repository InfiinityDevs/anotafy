{
	// tsconfig.json
	"compilerOptions": {
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		// ... suas outras opções
		"target": "es2016",
		"module": "commonjs",
		"rootDir": "./src",
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}
